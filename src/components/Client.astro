---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const c = dict.client;
---

<!--
  SESSION MEMORY, part two (§15).
  Six sections after the visitor taught it a rule, the page uses it — quietly,
  with an editorial footnote rather than a banner. If no rule was taught, the
  neutral reply is shown and the footnote never appears.
-->
<section class="client band" id="client" data-produces="5" data-action="answered-client" data-shift="18:20">
  <div class="page client__grid">
    <div class="client__lede">
      <p class="label">{c.label}</p>
      <h2 class="title client__title">{c.title}</h2>
    </div>

    <div
      class="client__thread"
      data-rule-target
      data-replies={JSON.stringify(c.replies)}
      data-rule-names={JSON.stringify(c.ruleNames)}
      data-reveal="receive"
    >
      <div class="client__in">
        <div class="client__in-head">
          <span class="label">{c.incomingLabel}</span>
          <span class="client__who">{c.incoming.from}</span>
          <span class="client__chan sys">{c.incoming.channel}</span>
        </div>
        <p class="client__msg human">{c.incoming.text}</p>
      </div>

      <div class="client__out">
        <p class="label client__out-label">{c.draftLabel}</p>
        <p class="client__reply" data-rule-text>{c.replies.skip}</p>

        <p class="client__fn" data-rule-note hidden>
          <sup>1</sup>
          <span class="client__fn-id sys">{c.ruleNoteLabel}</span>
          <span class="client__fn-name" data-rule-name></span>
          <span class="client__fn-when">— {c.ruleNote}</span>
        </p>

        <p class="note client__send">{c.sendLabel}</p>
      </div>

      <p class="client__follow human">{c.followUp}</p>
    </div>
  </div>
</section>

<style>
  .client {
    border-bottom: 1px solid var(--rule);
  }
  .client__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .client__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
  }
  .client__title {
    margin-top: 0.6rem;
    max-width: 12ch;
  }

  .client__in {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .client__in-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }
  .client__who {
    font-weight: 580;
  }
  .client__chan {
    font-size: var(--step-micro);
    color: var(--machine);
  }
  .client__msg {
    margin-top: 0.6rem;
    font-size: var(--step-lead);
    color: var(--ink);
    max-width: 40ch;
  }

  .client__out {
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
    border-left: 2px solid var(--signal);
    padding-left: clamp(0.9rem, 2vw, 1.4rem);
  }
  .client__out-label {
    color: var(--signal);
  }
  .client__reply {
    margin-top: 0.5rem;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink);
    max-width: 42ch;
    /* the reply is re-rendered when the rule changes — a soft crossfade,
       never a jump */
    transition: opacity var(--dur-normal) var(--ease-standard);
  }

  .client__fn {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-human);
    font-style: italic;
    font-size: var(--step-small);
    color: var(--machine);
  }
  .client__fn[hidden] {
    display: none;
  }
  .client__fn sup {
    font-family: var(--font-system);
    font-style: normal;
    font-size: 0.625rem;
    color: var(--signal);
  }
  .client__fn-id {
    font-style: normal;
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--signal);
  }
  .client__fn-name {
    color: var(--ink-muted);
  }

  .client__send {
    margin-top: 0.75rem;
  }

  .client__follow {
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    max-width: 36ch;
  }
</style>
