---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const l = dict.ledger;
---

<!--
  ECONOMICS (§10 "ledger" projection).
  Tabular information gets a table — with a caption, header scope and a labelled
  scroll region — not a grid of rounded cards.
-->
<!--
  Dark, because it is twenty to one in the morning.

  The page runs one shift, and it had gone dark at 23:20 and 23:40 and then
  snapped back to paper at 00:40 — the deepest hour on it — before staying light
  until the handover at 07:10. That is not a matter of taste, it is the page
  disagreeing with its own clock: this was the only night section on paper.

  Dark also suits what the section does. It is a reckoning of what a person costs
  against what this costs, and it is the one place the page counts in money; the
  machine's own ground is the right one to count on.
-->
<section class="ledger band on-ink" id="ledger" data-shift="00:40" data-field-surface="0.4">
  <canvas class="band-field" data-band-field aria-hidden="true"></canvas>
  <div class="page">
    <p class="label">{l.label}</p>
    <h2 class="title ledger__title" data-reveal="handover">{l.title}</h2>

    <div class="ledger__scroll" tabindex="0" role="region" aria-label={l.caption}>
      <table class="ledger__table">
        <caption class="sr-only">{l.caption}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">{l.caption}</span></th>
            <th scope="col" class="label">{l.humanCol}</th>
            <th scope="col" class="label ledger__us">{l.echelonCol}</th>
          </tr>
        </thead>
        <tbody>
          {
            l.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td class="sys">{r.human}</td>
                <td class="sys ledger__us">{r.echelon}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="ledger__bottom" data-reveal="resolve">{l.bottom}</p>
  </div>
</section>

<style>
  .ledger {
    border-bottom: 1px solid var(--rule);
  }
  .ledger__title {
    margin-top: 0.6rem;
    max-width: 22ch;
  }
  .ledger__scroll {
    margin-top: clamp(2rem, 5vh, 3.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .ledger__table {
    width: 100%;
    min-width: 32rem;
    max-width: 64rem;
    border-collapse: collapse;
    text-align: left;
  }
  .ledger__table th,
  .ledger__table td {
    padding: 0.9rem 1rem 0.9rem 0;
    vertical-align: baseline;
  }
  .ledger__table thead th {
    font-size: var(--step-micro);
    padding-bottom: 0.6rem;
    color: var(--machine);
  }
  .ledger__table tbody th {
    font-weight: 500;
    color: var(--ink);
    border-top: 1px solid var(--rule);
    max-width: 30ch;
  }
  .ledger__table tbody td {
    border-top: 1px solid var(--rule);
    color: var(--machine);
    width: 9rem;
  }
  .ledger__us {
    color: var(--signal) !important;
  }

  /*
   * Both columns, on a phone, without a sideways scroll nobody discovers.
   *
   * `min-width: 32rem` forced the table 512 px wide inside a 390 px screen. The
   * wrapper scrolls, so nothing was technically lost — but the column that was
   * off the edge was the ECHELON one, which is the entire point of the
   * comparison. What a reader actually saw was a single column of да · да · да ·
   * нет · нет against "помощник в штате", with no sign that a second column
   * existed. That is worse than unreadable: those answers describe the human,
   * and read alone they invite exactly the opposite conclusion.
   *
   * Not restacked into blocks, which is the usual answer and the wrong one here:
   * `display: block` on rows and cells strips the table its semantics, and this
   * is a real comparison table that a screen reader should keep announcing as
   * one. The values are two or three characters wide; they only needed to stop
   * being told to occupy 9 rem each.
   */
  @media (max-width: 47.999rem) {
    .ledger__table {
      min-width: 0;
    }
    .ledger__table th,
    .ledger__table td {
      padding-right: 0.6rem;
    }
    .ledger__table tbody td {
      width: auto;
      white-space: nowrap;
    }
    .ledger__table tbody th {
      max-width: none;
    }
  }
  .ledger__bottom {
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
    font-size: var(--step-lead);
    font-weight: 560;
    max-width: 34ch;
    color: var(--ink);
  }
</style>
