---
import { asset, type Dict, type Locale } from '../i18n';

interface Props {
  dict: Dict;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const v = dict.voice;
/* Only RU and EN recordings exist; UZ falls back to the Russian one, which is
   what a Tashkent owner would hear on the call anyway. */
const recording = asset(locale === 'en' ? 'voice_en.mp3' : 'voice_ru.mp3');

const mark = (text: string, marks: readonly string[]) => {
  if (!marks.length) return [{ text, marked: false }];
  const pattern = marks
    .map((m) => m.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    .sort((a, b) => b.length - a.length)
    .join('|');
  const re = new RegExp(`(${pattern})`, 'gi');
  return text
    .split(re)
    .filter(Boolean)
    .map((part) => ({ text: part, marked: marks.some((m) => m.toLowerCase() === part.toLowerCase()) }));
};
---

<!--
  VOICE (§23).

  This section used to say "no glowing orb" and mean it: a flat tape trace, a
  play link, three empty rules. The judgement about the orb was right and the
  result was wrong — it left the strongest claim on the page, the one where the
  product stops being compared to Jarvis and simply talks, with nothing to look
  at. So the core is back, drawn rather than lit (motion/core.ts): hairline
  latitude rings and a point lattice in the journal's own inks, deformed by a
  real FFT of whatever is actually playing.

  The tape stays underneath it. The core shows the shape of the voice; the tape
  shows its history, and it is the thing that still works if WebAudio does not.
-->
<section class="voice band on-ink" id="voice" data-shift="23:40" data-field-surface="0.55">
  <canvas class="band-field" data-band-field aria-hidden="true"></canvas>
  <div class="page voice__grid">
    <div class="voice__intro">
      <p class="label">{v.label}</p>
      <h2 class="title voice__title">{v.title}</h2>
      <p class="lead voice__copy">{v.copy}</p>
    </div>

    <div
      class="voice__console"
      data-voice
      data-recording={recording}
      data-locale={locale}
      data-entities={JSON.stringify(v.coreEntities)}
      data-msg-connecting={v.connecting}
      data-msg-listening={v.listening}
      data-msg-thinking={v.thinking}
      data-msg-speaking={v.speaking}
      data-msg-idle={v.idle}
      data-msg-mic-denied={v.micDenied}
      data-msg-error={v.error}
      data-label-play={v.playRecording}
      data-label-stop={v.stopRecording}
    >
      <div class="voice__core">
        <div class="voice__stage" aria-hidden="true">
          <canvas class="voice__core-canvas" data-voice-core></canvas>
        </div>
      </div>

      <!--
        What it is holding, as text.

        These five names used to be painted into the canvas, which cost PHASE 17
        a bespoke contrast gate: type declared as a computed alpha is invisible
        to both scripts/contrast.mjs and axe-core, so it had to be measured by
        hand at every stop of the ambient ramp. As markup they are selectable,
        announced, and gated by the same two tools as every other word on the
        page — and the sphere goes back to being exactly the object the product
        draws, which is the whole point of putting it here.
      -->
      <div class="voice__memory">
        <p class="voice__memory-label label">{v.coreLabel}</p>
        <!-- ARCHIVE, and stAggered: the pattern for something settling into
             memory, which is exactly what these are. RECEIVE was the first
             choice and was wrong twice over — it is the pattern for an event
             arriving on a line, and its 0.9 s left-to-right clip on a pill this
             small wipes across the word itself, so the names stayed unreadable
             for the better part of two seconds after the row had arrived. -->
        <ul class="voice__entities" data-stagger>
          {
            v.coreEntities.map((e) => (
              <li class="voice__entity" data-reveal="archive">
                <span class="voice__entity-dot" aria-hidden="true" />
                <span class="voice__entity-name">{e.label}</span>
                <span class="voice__entity-kind sys">{e.kind}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="voice__controls">
        <button type="button" class="act-quiet voice__play" data-voice-play data-cursor="speak">
          <span class="voice__play-glyph" aria-hidden="true">▶</span>
          <span data-voice-play-label>{v.playRecording}</span>
        </button>
        <button type="button" class="act-quiet voice__talk" data-voice-talk hidden data-cursor="speak">
          {v.talkButton}
        </button>
        <button type="button" class="act-quiet voice__stop" data-voice-stop hidden data-cursor="stop">
          {v.stopButton}
        </button>
        <p class="voice__state label" data-voice-state role="status">{v.idle}</p>
      </div>

      <div class="voice__tape">
        <canvas class="voice__wave" data-voice-wave aria-hidden="true"></canvas>
        <span class="voice__baseline" aria-hidden="true"></span>
      </div>
    </div>

    <div class="voice__transcript">
      <p class="label voice__transcript-label">{v.transcriptLabel}</p>
      <ol class="voice__lines">
        {
          v.transcript.map((line) => (
            <li class={`voice__line voice__line--${line.who}`} data-reveal="receive">
              <span class="voice__who label">{v.speakers[line.who]}</span>
              <p class="voice__said">
                {mark(line.text, ('marks' in line ? line.marks : undefined) ?? []).map((part) =>
                  part.marked ? <mark class="voice__mem">{part.text}</mark> : <>{part.text}</>,
                )}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="note voice__marks-note">{v.marksNote}</p>
    </div>
  </div>
</section>

<style>
  .voice {
    border-bottom: 1px solid var(--rule);
  }
  /* Two columns rather than one: the copy stayed at reading width on the left
     while the right half of this section sat empty, which is most of what made
     the page feel unfinished. The core now occupies it. */
  .voice__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .voice__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }
    /*
      The console does NOT stick, and that is a bug fix rather than a taste
      change.

      It used to, to hold the core beside the copy while the reader was at the
      top of the section. Measured at 1440, 1280 and 992, the transcript below it
      overlapped the stuck console by 450 px, and `elementFromPoint` at the centre
      of «Послушать» returned a `.voice__said` line: the section's primary control
      could not be pressed at all on any desktop width. Playwright found it while
      trying to hover the button and reported, four times over, that the
      transcript "intercepts pointer events".

      It only ever worked while the console was short. The sphere, the memory
      chips, the controls and the tape have made it tall enough that sticking it
      buys a little proximity and costs the button.
    */
    .voice__transcript {
      grid-column: 1 / -1;
    }
  }

  .voice__title {
    margin-top: 0.6rem;
    max-width: 15ch;
  }
  .voice__copy {
    margin-top: 1rem;
  }

  /*
    The stage the sphere stands on, and it is the product's own: the same warm
    medallion the voice panel uses in the app, and a radius, because in this
    system the journal is flat and only the machine is rounded. Everything else
    in the section is a hairline on ink; this one object is allowed to glow,
    because it is the one object that is actually running.
  */
  .voice__core {
    position: relative;
  }
  .voice__stage {
    position: relative;
    border: 1px solid #2a2116;
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 50% 42%, #261a0b 0%, #15100a 58%, #0c0805 100%);
    overflow: hidden;
    /* A fixed ratio, so nothing reflows as the state line changes underneath. */
    aspect-ratio: 5 / 4;
  }
  /* the warm spill the panel throws onto the ink around it */
  .voice__stage::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 60px rgba(255, 150, 40, 0.05);
  }
  .voice__core-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .voice__memory {
    margin-top: 1.25rem;
  }
  .voice__memory-label {
    font-size: var(--step-micro);
    color: var(--machine);
  }
  .voice__entities {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  .voice__entity {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.65rem 0.32rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
  }
  .voice__entity-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffae3c;
    /* the sphere's own gold, so the names read as belonging to it */
    flex: none;
    align-self: center;
  }
  .voice__entity-name {
    font-size: var(--step-small);
    color: var(--ink);
  }
  .voice__entity-kind {
    font-size: var(--step-micro);
    color: var(--machine);
  }

  .voice__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }
  .voice__play-glyph {
    font-size: 0.7em;
    color: var(--signal);
  }
  /* Beside the control, not banished to the far edge. `margin-left: auto` put
     the state line 550 px from the button it describes on a wide screen, which
     reads as two unrelated things rather than as a control and its readout. */
  .voice__state {
    color: var(--machine);
    padding-left: 0.25rem;
    border-left: 1px solid var(--rule);
  }

  /* The tape: the voice's history, under its present shape. Shorter than it was
     — beside the core, a tall empty box read as an unfilled form. */
  .voice__tape {
    position: relative;
    margin-top: 0.9rem;
    height: clamp(2.5rem, 6vh, 3.75rem);
    /* A tape is a record, and before anything has been said there is nothing on
       it. Boxed, it put three hairlines around an empty rectangle — which is the
       unfilled-form reading this section was rebuilt to stop producing, and
       shortening the box only made it a shorter empty form. At rest the baseline
       carries it alone: a flat line is what silence looks like on a tape, and the
       word beside it already says ТИШИНА.

       Transparent rather than absent, so the borders arriving move nothing. */
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-expressive) var(--ease-standard);
  }
  .voice__console[data-tape-live] .voice__tape {
    border-color: var(--rule);
  }
  .voice__wave {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .voice__baseline {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--rule);
  }

  .voice__transcript {
    margin-top: clamp(2.25rem, 6vh, 3.5rem);
  }
  .voice__lines {
    margin-top: 1rem;
    max-width: 46rem;
  }
  .voice__line {
    display: grid;
    grid-template-columns: minmax(4.5rem, max-content) minmax(0, 1fr);
    gap: 0.3rem 1.25rem;
    padding-block: clamp(0.9rem, 2vh, 1.35rem);
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .voice__line:last-of-type {
    border-bottom: 1px solid var(--rule);
  }
  .voice__who {
    font-size: var(--step-micro);
  }
  .voice__line--you .voice__who {
    color: var(--signal);
  }
  .voice__said {
    font-size: clamp(1.125rem, 1rem + 0.75vw, 1.6rem);
    line-height: 1.4;
    color: var(--ink);
    max-width: 34ch;
  }
  .voice__line--you .voice__said {
    font-family: var(--font-human);
    font-style: italic;
  }

  /* what it knows from memory, marked the way a document marks a citation */
  .voice__mem {
    background: none;
    color: inherit;
    border-bottom: 2px solid var(--signal-edge);
    padding-bottom: 0.05em;
  }

  .voice__marks-note {
    margin-top: 1rem;
  }

  @media (max-width: 35.999rem) {
    .voice__line {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
    .voice__state {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>

<script>
  import { initVoice } from '../motion/voice';
  initVoice();
</script>
