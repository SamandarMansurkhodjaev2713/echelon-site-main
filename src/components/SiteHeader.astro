---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, localePath, type Dict, type Locale } from '../i18n';
import { shiftIndex } from '../lib/shift-index';

interface Props {
  dict: Dict;
  locale: Locale;
}

const { dict, locale } = Astro.props;

/*
 * THE SHIFT INDEX.
 *
 * The page had no section navigation at all: a brand, a clock, three language
 * links and a call to action, and the only way to reach the middle of a
 * sixteen-thousand-pixel document was to scroll it. A generic drop-down of
 * links would have been the easy answer and the wrong one — this page is one
 * working shift, so its index is the shift, and you navigate it by the hour.
 *
 * The list itself lives in lib/shift-index.ts, because the footer shows it too.
 */
const INDEX = shiftIndex(dict);
---

<header class="masthead" data-masthead>
  <div class="page masthead__row">
    <a class="masthead__brand" href={localePath(locale)} data-cursor="return">
      <Image src={mark} alt="" width={22} height={22} loading="eager" densities={[1, 2]} />
      <span class="masthead__mark">Echelon</span>
      <span class="masthead__sub">Desktop</span>
    </a>

    <!-- The index opens the shift. Same control and same panel on every width:
         a phone does not get a lesser menu, it gets this one. -->
    <button
      type="button"
      class="masthead__index"
      aria-expanded="false"
      aria-controls="shift-index"
      data-index-toggle
      data-cursor="open"
    >
      <span class="masthead__index-bars" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <span class="masthead__index-word">{dict.nav.sections}</span>
    </button>

    <!--
      The shift clock. The whole page is one working day, and this is the only
      element that says so continuously: it advances as you read, because the
      sections declare the time they depict and motion/shift.ts interpolates
      between them. Not decoration — it is the same value driving the ambient
      light and the load on the attention field, so all three agree by
      construction. aria-hidden because it is a restatement of scroll position,
      and announcing a clock that moves on every scroll event would be hostile.
    -->
    <p class="masthead__clock" aria-hidden="true">
      <span class="masthead__time sys" data-shift-clock>08:50</span>
      <span class="masthead__phase" data-shift-phase></span>
    </p>

    <nav class="masthead__langs" aria-label={dict.nav.langLabel}>
      {
        LOCALES.map((l) => (
          <a
            href={localePath(l)}
            hreflang={LOCALE_TAGS[l]}
            lang={LOCALE_TAGS[l]}
            class={l === locale ? 'is-current' : ''}
            aria-current={l === locale ? 'page' : undefined}
            data-cursor="open"
          >
            {LOCALE_LABELS[l]}
          </a>
        ))
      }
    </nav>

    <a class="masthead__cta" href="#handover" data-cursor="approve">
      <span>{dict.nav.cta}</span>
    </a>
  </div>

  <!--
    THE SHIFT SCALE.

    The page is one working day, so its progress indicator is a day: the filled
    part is the shift you have read, and each notch is a section standing at the
    hour it depicts. It is populated by script because a notch's place is the
    section's real position in the document, not a number anyone can type.

    Deliberately not a control. Making the notches clickable means giving them a
    24 px hit area, which at the foot of a 56 px masthead is a full-width
    transparent strip lying across the language switcher and the call to action —
    the exact defect that already cost this header three rounds of debugging,
    rebuilt on purpose. The page's navigation lives in the pillars index, where
    the links are the size of a thumb and exist on every device. This is a
    display, and it says so: aria-hidden, pointer-events: none.
  -->
  <div class="shiftbar" data-shiftbar aria-hidden="true"></div>

  <!--
    The panel is dark on every ground, including the light ones, and that is the
    point: opening the index is stepping out of the record and into the machine
    that keeps it. It is the same surface the product window and the night band
    are made of, so the site has one answer for "this is the system" instead of
    three.
  -->
  <div class="shift-index on-ink" id="shift-index" data-index-panel hidden>
    <div class="page shift-index__inner">
      <p class="shift-index__label label">{dict.nav.sections}</p>
      <ol class="shift-index__list">
        {
          INDEX.map((s) => (
            <li class="shift-index__row">
              <a class="shift-index__link" href={`#${s.id}`} data-index-link={s.id} data-cursor="view">
                <span class="shift-index__at sys" data-index-at aria-hidden="true" />
                <span class="shift-index__name">{s.name}</span>
                <span class="shift-index__rule" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* anchors the read-progress hairline below */
    isolation: isolate;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--rule);
    /* the header is a rule on paper, not a floating glass bar */
    backdrop-filter: saturate(1.1) blur(8px);
    -webkit-backdrop-filter: saturate(1.1) blur(8px);
    /* Crossing into a dark band swaps the whole token set under this element
       (see the observer in the script). Transitioning the three resolved colours
       turns that swap into the bar passing through a doorway rather than into a
       cut — and it is deliberately slower than --dur-normal, because the thing
       actually moving is the page behind it, not the bar. */
    transition:
      background-color var(--dur-expressive) var(--ease-standard),
      border-color var(--dur-expressive) var(--ease-standard),
      color var(--dur-expressive) var(--ease-standard);
  }

  /* ---------- the index control ---------- */

  .masthead__index {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    padding-inline: 0.15rem;
    font-family: var(--font-system);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .masthead__index:hover,
  .masthead__index:focus-visible {
    color: var(--ink);
  }

  /* Three rules that become a cross. Not a hamburger borrowed from a phone app:
     they are the same hairlines the page is set in, and they are of different
     lengths, because the index they open is a list of unequal things. */
  .masthead__index-bars {
    display: grid;
    gap: 3px;
    width: 15px;
  }
  .masthead__index-bars i {
    height: 1px;
    background: currentColor;
    transition:
      transform var(--dur-normal) var(--ease-editorial),
      opacity var(--dur-fast) var(--ease-standard),
      width var(--dur-normal) var(--ease-editorial);
  }
  .masthead__index-bars i:nth-child(1) {
    width: 15px;
  }
  .masthead__index-bars i:nth-child(2) {
    width: 10px;
  }
  .masthead__index-bars i:nth-child(3) {
    width: 13px;
  }
  [aria-expanded='true'] .masthead__index-bars i:nth-child(1) {
    width: 15px;
    transform: translateY(4px) rotate(45deg);
  }
  [aria-expanded='true'] .masthead__index-bars i:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded='true'] .masthead__index-bars i:nth-child(3) {
    width: 15px;
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ---------- the panel ---------- */

  .shift-index {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--rule-strong);
    overflow: hidden;
    /* Opens by clip rather than by height: a height transition on a list this
       long reflows every row on every frame, and this panel can be opened while
       the page behind it is still scrolling. */
    clip-path: inset(0 0 100% 0);
    /* Closed it must also be unreachable, or fourteen links stay in the tab
       order behind a panel nobody can see. `visibility` does that and is the one
       property that can be transitioned, so it waits for the wipe to finish on
       the way out and applies immediately on the way in. */
    visibility: hidden;
    transition:
      clip-path var(--dur-expressive) var(--ease-editorial),
      visibility 0s linear var(--dur-expressive);
  }
  .shift-index.is-open {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path var(--dur-expressive) var(--ease-editorial),
      visibility 0s;
  }

  .shift-index__inner {
    padding-block: clamp(1.25rem, 3vh, 2rem) clamp(1.5rem, 4vh, 2.5rem);
  }
  .shift-index__label {
    color: var(--machine);
  }
  .shift-index__list {
    margin-top: 0.75rem;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .shift-index__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .shift-index__link {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, auto) minmax(1.5rem, 1fr);
    align-items: baseline;
    gap: 0.9rem;
    /* 44 px of thumb on every row, which is what the old comment said the
       shift scale could not give and used as the reason to have no navigation
       at all. A panel has the room the header bar did not. */
    min-height: 2.75rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .shift-index__row:last-child .shift-index__link {
    border-bottom: 1px solid var(--rule);
  }
  .shift-index__at {
    font-size: var(--step-micro);
    color: var(--machine);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .shift-index__name {
    font-size: var(--step-lead);
    letter-spacing: -0.012em;
  }
  /* The hairline runs to the edge and fills toward the reader on hover — the
     row completing itself, the same gesture the record uses everywhere else. */
  .shift-index__rule {
    height: 1px;
    background: linear-gradient(to right, var(--signal) 0 0) left / 0 100% no-repeat,
      linear-gradient(to right, var(--rule) 0 0) left / 100% 100% no-repeat;
    transition: background-size var(--dur-expressive) var(--ease-editorial);
    align-self: center;
  }
  .shift-index__link:hover,
  .shift-index__link:focus-visible {
    color: var(--signal);
  }
  .shift-index__link:hover .shift-index__rule,
  .shift-index__link:focus-visible .shift-index__rule {
    background-size:
      100% 100%,
      100% 100%;
  }
  .shift-index__link[aria-current='true'] .shift-index__at {
    color: var(--signal);
  }
  .shift-index__link[aria-current='true'] .shift-index__name {
    font-weight: 620;
  }

  .shift-index__langs {
    margin-top: 1.25rem;
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-system);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
  }
  .shift-index__langs a {
    color: var(--machine);
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
  }
  .shift-index__langs a.is-current {
    color: var(--ink);
    border-bottom: 1px solid var(--signal);
  }

  /* The scale steps aside for the index — see setOpen(). */
  .masthead[data-indexing] .shiftbar {
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-standard);
  }

  @media (prefers-reduced-motion: reduce) {
    .shift-index {
      transition-duration: 1ms;
    }
    .masthead__index-bars i {
      transition-duration: 1ms;
    }
  }

  .masthead__row {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 3.5rem;
  }

  .masthead__brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .masthead__brand img {
    align-self: center;
    border-radius: 4px;
  }
  .masthead__mark {
    font-size: 1.0625rem;
  }
  .masthead__sub {
    font-family: var(--font-system);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }

  .masthead__clock {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-micro);
    color: var(--machine);
    font-variant-numeric: tabular-nums;
  }
  .masthead__time {
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  /* A dot that fills as the shift goes dark — the state of the day at a glance. */
  .masthead__phase {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: linear-gradient(
      to top,
      var(--ink) calc(var(--night, 0) * 100%),
      transparent calc(var(--night, 0) * 100%)
    );
  }

  .masthead__langs {
    margin-left: clamp(0.5rem, 2vw, 1.5rem);
    display: flex;
    gap: 0.15rem;
    font-family: var(--font-system);
    font-size: var(--step-micro);
  }
  .masthead__langs a {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    color: var(--machine);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .masthead__langs a:hover {
    color: var(--ink);
  }
  .masthead__langs a.is-current {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
  }

  .masthead__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5em 1.05em;
    font-size: var(--step-small);
    font-weight: 580;
    color: var(--paper);
    background: var(--ink);
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .masthead__cta:hover,
  .masthead__cta:focus-visible {
    background: var(--signal);
  }

  /* The masthead is not part of the operation — it arrives with the hero. */
  :global(html[data-intro]) .masthead {
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-intro-phase='settle']) .masthead {
    opacity: 1;
    transition: opacity var(--dur-expressive) var(--ease-enter) 180ms;
  }

  /* A hairline that fills as the shift is read. It is a border on the masthead
     rather than an element, so it cannot shift a single pixel of layout. */
  .masthead::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: calc(var(--read, 0) * 100%);
    background: var(--signal);
    z-index: 1;
  }

  /* ---- the shift scale ---- */
  .shiftbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    pointer-events: none;
  }
  /*
   * `:global` on everything the script creates, and it is not optional.
   *
   * Astro scopes a component's styles by appending its own attribute to each
   * selector, and a span made with `document.createElement` does not carry that
   * attribute — so these rules matched nothing at all. The notches were in the
   * DOM, in the right places, computing as `display: inline`, `position: static`
   * and 0 × 0: present, correct, and invisible. Only looking at it found that;
   * every programmatic check said the scale was built.
   */
  .shiftbar :global(.shiftbar__tick) {
    position: absolute;
    bottom: 0;
    /* `left` is written by the script as a percentage of the document */
    width: 1px;
    height: 5px;
    background: var(--machine);
  }
  /* The hour a section depicts, set beside its own notch. Only every other one
     is labelled: thirteen times along a 1440 px rail collide, and a scale you
     cannot read is decoration. */
  .shiftbar :global(.shiftbar__tick[data-label])::after {
    content: attr(data-label);
    position: absolute;
    bottom: 7px;
    left: 0;
    transform: translateX(-50%);
    font-family: var(--font-system);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--machine);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity var(--dur-normal) var(--ease-standard);
  }
  /* An hour centred on a notch four pixels from the edge loses half of itself off
     the side of the page — the first label read ":50". The two end notches hang
     their label inward instead. */
  .shiftbar :global(.shiftbar__tick[data-edge='start'])::after {
    transform: none;
  }
  .shiftbar :global(.shiftbar__tick[data-edge='end'])::after {
    transform: translateX(-100%);
  }

  /* The scale is quiet until you look at it. Hovering the masthead is the
     gesture that means "where am I" — the labels answer, and then leave. */
  .masthead:hover .shiftbar :global(.shiftbar__tick[data-label])::after {
    opacity: 1;
  }
  /* Where the reader is now. Sits above the notches so it is never lost in one. */
  .shiftbar :global(.shiftbar__now) {
    position: absolute;
    bottom: 0;
    left: calc(var(--read, 0) * 100%);
    width: 2px;
    height: 9px;
    margin-left: -1px;
    background: var(--signal);
  }

  /* A one-pixel rail is a pointer affordance. On a touch screen it would be an
     ornament nobody can use and a row of hairlines under the masthead, so it is
     not drawn at all. */
  @media not all and (hover: hover) and (pointer: fine) {
    .shiftbar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shiftbar :global(.shiftbar__tick[data-label])::after {
      transition: none;
    }
  }

  /*
   * Narrow: everything fits, because the wordmark stands down.
   *
   * The old rule cut the shift clock first, which meant that on a phone — where
   * most people meet this page — nothing said continuously that it depicts a
   * working day. That was worth fixing. It was not worth fixing the way I first
   * fixed it: by making the masthead's contents depend on scroll position, so
   * the call to action appeared once the hero was behind you and the clock stood
   * down. That is a feedback loop in the one element that must never wobble —
   * the header changes its own layout, the layout moves the hero, the hero
   * changes the header — and it cost three rounds of debugging, a hysteresis
   * margin to damp it, and it still could not be clicked reliably on every
   * device. Removed rather than propped up further.
   *
   * The measurement that made it unnecessary: at 360 px, with the wordmark
   * hidden, brand 18–40, languages 116–212 and the button 219–342 all sit inside
   * the row with room to spare. The wordmark is the thing that can go; the mark
   * beside it still identifies the page, and the wordmark is set full size at the
   * top of the document anyway. Nothing here depends on where the reader is.
   */
  @media (max-width: 30rem) {
    /*
     * Hidden from the eye, not from the accessibility tree.
     *
     * `display: none` here removed the only text the brand link had — the image
     * beside it is decorative with an empty alt, and "Desktop" is hidden at this
     * width too — so the link had no accessible name at all and axe was right to
     * call it serious. A wordmark that is merely too wide to draw is still the
     * name of the thing; it should stop being painted, not stop existing.
     */
    .masthead__mark {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    /* With the wordmark gone the brand link is exactly the 22 px image, which is
       under the target-size floor — the link stopped being big enough to press
       the moment it stopped carrying text. The box grows; the mark does not. */
    .masthead__brand {
      min-width: 2.5rem;
      min-height: 2.5rem;
      justify-content: center;
    }
  }
  /* Below this the clock is the one that yields: the row genuinely does not fit,
     and a call to action outranks a restatement of scroll position.

     Raised from 23rem to 27rem when the index joined the row. The old number was
     right for four elements and wrong for five: measured at 390 px the row came
     out 2 px over its own box, and at 560 px — where "Desktop" returns to the
     brand — 18 px over. Neither is a rounding artefact; both put the page into
     horizontal overflow. The two optional elements now stand down until there is
     actually room for them. */
  @media (max-width: 27rem) {
    .masthead__clock {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .masthead__sub {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .masthead__row {
      gap: 0.4rem;
    }
    .masthead__langs a {
      min-width: 2.1rem;
    }
    .masthead__cta {
      font-size: var(--step-micro);
      padding-inline: 0.75em;
    }
  }
  /* The narrowest phones still in use. Everything that can give, gives — and it
     is measured: at 320 px the row was 4 px over even with the clock already
     down, which is a scrollbar on the whole document for the sake of two
     letters of padding. */
  @media (max-width: 22.5rem) {
    .masthead__langs a {
      min-width: 1.75rem;
    }
    .masthead__cta {
      padding-inline: 0.55em;
    }
    .masthead__row {
      gap: 0.3rem;
    }
  }

  /*
   * The bar was at four elements and the index makes five, so something has to
   * give on a phone — and it is the *word*, not the language switch.
   *
   * Moving the switch into the panel was tried first and was wrong. This is a
   * trilingual site for a country where the reader may well want the other
   * language on sight; burying that behind a menu puts a first-order control one
   * tap deeper on the device where taps cost most, and the header already went
   * to the trouble of narrowing those hit areas at 30rem and 22.5rem precisely
   * so it could keep them. It also put two navigation landmarks called "Язык" on
   * the same page, which is a thing a screen reader now has to disambiguate.
   *
   * Below 36rem the three rules carry the control alone. They are the same
   * hairlines the page is set in, they animate to a cross when open, and next to
   * a shift scale made of notches they do not read as a borrowed hamburger.
   */
  @media (max-width: 36rem) {
    .masthead__index-word {
      display: none;
    }
  }
</style>

<script>
  import { register, listen } from '../motion/lifecycle';

  /*
   * Populates the shift scale.
   *
   * A notch's place is the section's real position in the document, measured
   * against the same denominator the read-progress hairline uses — so when the
   * playhead sits on a notch the reader is genuinely at that section rather than
   * approximately near it. A wrong denominator would not look broken; it would
   * look like a scale that lies quietly, which is worse.
   *
   * Measured on load and after a resize, never per frame. The playhead rides
   * `--read`, which the shift clock already publishes, so while the page is
   * being read this has nothing to do.
   */
  const bar = document.querySelector<HTMLElement>('[data-shiftbar]');
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('main > section[data-shift]'),
  );

  if (bar && sections.length) {
    const build = () => {
      const span = document.documentElement.scrollHeight - window.innerHeight;
      bar.textContent = '';
      if (span <= 0) return;

      sections.forEach((el, i) => {
        const at = (el.getBoundingClientRect().top + window.scrollY) / span;
        if (at < 0 || at > 1) return;
        const tick = document.createElement('span');
        tick.className = 'shiftbar__tick';
        tick.style.left = `${(at * 100).toFixed(3)}%`;
        // every other one carries its hour; see the stylesheet for why
        if (i % 2 === 0) {
          tick.dataset.label = el.dataset.shift ?? '';
          // a label centred on an end notch falls off the side of the page
          if (at < 0.05) tick.dataset.edge = 'start';
          else if (at > 0.95) tick.dataset.edge = 'end';
        }
        bar.append(tick);
      });

      const now = document.createElement('span');
      now.className = 'shiftbar__now';
      bar.append(now);
    };

    build();
    /* The document's height settles when the webfonts land: every section moves,
       and a scale measured before that is measured against a page that no longer
       exists. */
    if (document.fonts?.ready) void document.fonts.ready.then(build);

    let timer = 0;
    listen(window, 'resize', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(build, 180);
    });
    register(() => window.clearTimeout(timer));
  }

  /*
   * The masthead over a dark band.
   *
   * The header is a sticky bar of 88 % paper with ink type on it, and it stayed
   * exactly that while the night and voice sections — near-black, full width —
   * scrolled underneath. What a reader saw was a cream slab lying across the
   * darkest part of the page with the headline cut in half behind it: not a
   * header that belongs to the page, a foreign object parked on top of it.
   *
   * The fix is one class rather than a second set of rules, because every colour
   * in this component already comes from a token: adding `.on-ink` to the header
   * redefines --paper, --ink, --machine, --signal and --rule underneath it, and
   * the brand, the clock, the language switch, the shift scale and the read
   * hairline all invert together and cannot disagree.
   *
   * Which band is underneath is asked with an observer rather than measured on
   * scroll: the root is squeezed to a strip the height of the header itself, so
   * a dark section "intersects" exactly when it is behind the bar.
   */
  const mast = document.querySelector<HTMLElement>('[data-masthead]');
  const darkBands = Array.from(document.querySelectorAll<HTMLElement>('main .on-ink'));

  if (mast && darkBands.length) {
    const behind = new Set<Element>();
    let io: IntersectionObserver | null = null;

    const watch = () => {
      io?.disconnect();
      behind.clear();
      const h = Math.round(mast.getBoundingClientRect().height) || 56;
      const bottom = Math.max(0, window.innerHeight - h);
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) behind.add(e.target);
            else behind.delete(e.target);
          }
          mast.classList.toggle('on-ink', behind.size > 0);
        },
        { rootMargin: `0px 0px -${bottom}px 0px`, threshold: 0 },
      );
      for (const band of darkBands) io.observe(band);
    };

    watch();
    let reWatch = 0;
    listen(window, 'resize', () => {
      window.clearTimeout(reWatch);
      reWatch = window.setTimeout(watch, 180);
    });
    register(() => {
      window.clearTimeout(reWatch);
      io?.disconnect();
    });
  }

  /*
   * THE SHIFT INDEX — open, mark, close.
   *
   * The panel ships `hidden`, so without JavaScript it is not a broken control
   * sitting in the tab order; the script takes the attribute off and from then
   * on owns the state.
   */
  const toggle = document.querySelector<HTMLButtonElement>('[data-index-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-index-panel]');

  if (toggle && panel) {
    panel.removeAttribute('hidden');

    /* The hour of each row is read off the section it points at, never typed
       here — `data-shift` is the same value the ambient light and the header
       clock run on, and a second copy is a copy that can disagree. A row whose
       section has no hour keeps an empty slot rather than inventing one. */
    for (const link of panel.querySelectorAll<HTMLElement>('[data-index-link]')) {
      const target = document.getElementById(link.dataset.indexLink ?? '');
      const at = link.querySelector<HTMLElement>('[data-index-at]');
      /* One section has no hour on purpose — the day montage spans four of them
         and declaring any single one would put the page on the wrong day, which
         PHASE 16 had to unpick once already. It gets a rule rather than a blank,
         so the column reads as "runs through" instead of as a missing value. */
      if (at) at.textContent = target?.dataset.shift ?? '—';
    }

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      panel.classList.toggle('is-open', next);
      /* The shift scale hangs its hour labels below the bar, which is exactly
         where the panel opens; with both on screen the notches printed across
         the top of the index. The scale stands down while the index is up —
         they answer the same question, and only one of them can be read. */
      toggle.closest('header')?.toggleAttribute('data-indexing', next);
    };

    listen(toggle, 'click', () => setOpen(!open));

    /* Escape closes and hands focus back to the control that opened it —
       otherwise the caret is left inside a panel that is no longer on screen. */
    listen(document, 'keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });

    /* A chosen row closes the panel. The browser does the scrolling: these are
       real anchors, so they work with the history, with a middle-click, and with
       JavaScript switched off. */
    listen(panel, 'click', (e) => {
      if ((e.target as HTMLElement).closest('[data-index-link]')) setOpen(false);
    });

    /* Clicking the page behind it closes it too — but only a real click outside
       both the panel and its button, so the control does not fight itself. */
    listen(document, 'pointerdown', (e) => {
      if (!open) return;
      const t = e.target as Node;
      if (!panel.contains(t) && !toggle.contains(t)) setOpen(false);
    });

    /* Which row is the reader actually in. The same question the shift scale
       answers, asked the same way: whichever section owns the top third of the
       viewport is the current one. */
    const marks = new Map<string, HTMLElement>();
    for (const link of panel.querySelectorAll<HTMLElement>('[data-index-link]')) {
      marks.set(link.dataset.indexLink ?? '', link);
    }
    const targets = [...marks.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    if (targets.length) {
      const seen = new Map<string, number>();
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) seen.set(e.target.id, e.intersectionRatio);
          let bestId = '';
          let best = 0;
          for (const [id, r] of seen) {
            if (r > best) {
              best = r;
              bestId = id;
            }
          }
          for (const [id, link] of marks) {
            if (id === bestId && best > 0) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          }
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      for (const t of targets) spy.observe(t);
      register(() => spy.disconnect());
    }
  }
</script>

