---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, localePath, type Dict, type Locale } from '../i18n';

interface Props {
  dict: Dict;
  locale: Locale;
}

const { dict, locale } = Astro.props;
---

<header class="masthead" data-masthead>
  <div class="page masthead__row">
    <a class="masthead__brand" href={localePath(locale)} data-cursor="return">
      <Image src={mark} alt="" width={22} height={22} loading="eager" densities={[1, 2]} />
      <span class="masthead__mark">Echelon</span>
      <span class="masthead__sub">Desktop</span>
    </a>

    <nav class="masthead__langs" aria-label={dict.nav.langLabel}>
      {
        LOCALES.map((l) => (
          <a
            href={localePath(l)}
            hreflang={LOCALE_TAGS[l]}
            lang={LOCALE_TAGS[l]}
            class={l === locale ? 'is-current' : ''}
            aria-current={l === locale ? 'page' : undefined}
            data-cursor="open"
          >
            {LOCALE_LABELS[l]}
          </a>
        ))
      }
    </nav>

    <a class="masthead__cta" href="#handover" data-cursor="approve">
      <span>{dict.nav.cta}</span>
    </a>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--rule);
    /* the header is a rule on paper, not a floating glass bar */
    backdrop-filter: saturate(1.1) blur(8px);
    -webkit-backdrop-filter: saturate(1.1) blur(8px);
  }

  .masthead__row {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 3.5rem;
  }

  .masthead__brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .masthead__brand img {
    align-self: center;
    border-radius: 4px;
  }
  .masthead__mark {
    font-size: 1.0625rem;
  }
  .masthead__sub {
    font-family: var(--font-system);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }

  .masthead__langs {
    margin-left: auto;
    display: flex;
    gap: 0.15rem;
    font-family: var(--font-system);
    font-size: var(--step-micro);
  }
  .masthead__langs a {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    color: var(--machine);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .masthead__langs a:hover {
    color: var(--ink);
  }
  .masthead__langs a.is-current {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
  }

  .masthead__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5em 1.05em;
    font-size: var(--step-small);
    font-weight: 580;
    color: var(--paper);
    background: var(--ink);
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .masthead__cta:hover,
  .masthead__cta:focus-visible {
    background: var(--signal);
  }

  /* The masthead is not part of the operation — it arrives with the hero. */
  :global(html[data-intro]) .masthead {
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-intro-phase='settle']) .masthead {
    opacity: 1;
    transition: opacity var(--dur-expressive) var(--ease-enter) 180ms;
  }

  @media (max-width: 30rem) {
    .masthead__sub {
      display: none;
    }
    .masthead__row {
      gap: 0.4rem;
    }
    .masthead__langs a {
      min-width: 2.1rem;
    }
    .masthead__cta {
      font-size: var(--step-micro);
      padding-inline: 0.75em;
    }
  }
  @media (max-width: 22.5rem) {
    /* 320 px, longest locale: the brand mark alone still identifies the page */
    .masthead__mark {
      font-size: 0.9375rem;
    }
    .masthead__langs a {
      min-width: 1.9rem;
    }
  }
</style>
