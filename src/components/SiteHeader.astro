---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, localePath, type Dict, type Locale } from '../i18n';

interface Props {
  dict: Dict;
  locale: Locale;
}

const { dict, locale } = Astro.props;
---

<header class="masthead" data-masthead>
  <div class="page masthead__row">
    <a class="masthead__brand" href={localePath(locale)} data-cursor="return">
      <Image src={mark} alt="" width={22} height={22} loading="eager" densities={[1, 2]} />
      <span class="masthead__mark">Echelon</span>
      <span class="masthead__sub">Desktop</span>
    </a>

    <!--
      The shift clock. The whole page is one working day, and this is the only
      element that says so continuously: it advances as you read, because the
      sections declare the time they depict and motion/shift.ts interpolates
      between them. Not decoration — it is the same value driving the ambient
      light and the load on the attention field, so all three agree by
      construction. aria-hidden because it is a restatement of scroll position,
      and announcing a clock that moves on every scroll event would be hostile.
    -->
    <p class="masthead__clock" aria-hidden="true">
      <span class="masthead__time sys" data-shift-clock>08:50</span>
      <span class="masthead__phase" data-shift-phase></span>
    </p>

    <nav class="masthead__langs" aria-label={dict.nav.langLabel}>
      {
        LOCALES.map((l) => (
          <a
            href={localePath(l)}
            hreflang={LOCALE_TAGS[l]}
            lang={LOCALE_TAGS[l]}
            class={l === locale ? 'is-current' : ''}
            aria-current={l === locale ? 'page' : undefined}
            data-cursor="open"
          >
            {LOCALE_LABELS[l]}
          </a>
        ))
      }
    </nav>

    <a class="masthead__cta" href="#handover" data-cursor="approve">
      <span>{dict.nav.cta}</span>
    </a>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* anchors the read-progress hairline below */
    isolation: isolate;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--rule);
    /* the header is a rule on paper, not a floating glass bar */
    backdrop-filter: saturate(1.1) blur(8px);
    -webkit-backdrop-filter: saturate(1.1) blur(8px);
  }

  .masthead__row {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 3.5rem;
  }

  .masthead__brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .masthead__brand img {
    align-self: center;
    border-radius: 4px;
  }
  .masthead__mark {
    font-size: 1.0625rem;
  }
  .masthead__sub {
    font-family: var(--font-system);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }

  .masthead__clock {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-micro);
    color: var(--machine);
    font-variant-numeric: tabular-nums;
  }
  .masthead__time {
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  /* A dot that fills as the shift goes dark — the state of the day at a glance. */
  .masthead__phase {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: linear-gradient(
      to top,
      var(--ink) calc(var(--night, 0) * 100%),
      transparent calc(var(--night, 0) * 100%)
    );
  }

  .masthead__langs {
    margin-left: clamp(0.5rem, 2vw, 1.5rem);
    display: flex;
    gap: 0.15rem;
    font-family: var(--font-system);
    font-size: var(--step-micro);
  }
  .masthead__langs a {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    color: var(--machine);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .masthead__langs a:hover {
    color: var(--ink);
  }
  .masthead__langs a.is-current {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
  }

  .masthead__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5em 1.05em;
    font-size: var(--step-small);
    font-weight: 580;
    color: var(--paper);
    background: var(--ink);
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .masthead__cta:hover,
  .masthead__cta:focus-visible {
    background: var(--signal);
  }

  /* The masthead is not part of the operation — it arrives with the hero. */
  :global(html[data-intro]) .masthead {
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-intro-phase='settle']) .masthead {
    opacity: 1;
    transition: opacity var(--dur-expressive) var(--ease-enter) 180ms;
  }

  /* A hairline that fills as the shift is read. It is a border on the masthead
     rather than an element, so it cannot shift a single pixel of layout. */
  .masthead::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: calc(var(--read, 0) * 100%);
    background: var(--signal);
  }

  /*
   * Narrow: the clock and the call to action take turns.
   *
   * The old rule cut the clock first, on the grounds that brand, languages and
   * CTA all outrank it. That was the wrong question. Which of the two the row
   * can afford is a matter of *where the reader is*, not of abstract rank: at
   * the top of the page the hero's own call to action is a few hundred pixels
   * below and several times larger, so a second one in the masthead is
   * duplication crowding the narrowest row on the site. The clock is the one
   * element that says continuously that this page is a working day — on a phone
   * it was the only thing saying so, and it was the thing being switched off.
   *
   * Once the hero is behind you the trade reverses: the call to action is the
   * thing you might now want, and the clock stands down. Neither is ever fighting
   * the other for the same 40 px.
   */
  @media (max-width: 48rem) {
    .masthead__cta {
      display: none;
    }
    :global(html[data-past-hero]) .masthead__cta {
      display: inline-flex;
    }
    :global(html[data-past-hero]) .masthead__clock {
      display: none;
    }
    :global(html[data-past-hero]) .masthead__langs {
      margin-left: auto;
    }
    /* With the call to action back, the row is genuinely full at 360 px and
       something has to give. It is the wordmark: by the time you are reading, the
       mark alone identifies the page, and the wordmark is still the first thing
       on the page above. Left to flexbox this resolved itself by letting the
       language switcher sit on top of the button — the click landed on "EN". A
       row that overflows does not fail visibly; it fails as a control that cannot
       be pressed. */
    :global(html[data-past-hero]) .masthead__mark {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .masthead__sub {
      display: none;
    }
    .masthead__row {
      gap: 0.4rem;
    }
    .masthead__langs a {
      min-width: 2.1rem;
    }
    .masthead__cta {
      font-size: var(--step-micro);
      padding-inline: 0.75em;
    }
  }
  @media (max-width: 22.5rem) {
    /* 320 px, longest locale: the brand mark alone still identifies the page */
    .masthead__mark {
      font-size: 0.9375rem;
    }
    .masthead__langs a {
      min-width: 1.9rem;
    }
  }
</style>

<script>
  import { register } from '../motion/lifecycle';

  /* Drives the swap described in the stylesheet. An observer rather than a scroll
     listener: the answer changes twice in a visit, so paying for it per frame
     would be absurd. The attribute lives on <html> because the masthead is not
     the only thing that may eventually want to know the hero is behind us. */
  const hero = document.getElementById('top');
  if (hero) {
    const io = new IntersectionObserver(
      (entries) => {
        const e = entries[0];
        if (e) document.documentElement.toggleAttribute('data-past-hero', !e.isIntersecting);
      },
      /*
       * The trigger is kept far away from the hero's actual edge, and that is not
       * a tuning preference — without it this observer feeds itself. Flipping the
       * flag changes the masthead's own contents, that changes layout by a few
       * pixels, and a reader parked exactly at the hero's bottom edge would cross
       * the boundary back and forth on every reflow: a header that flickers as
       * long as you hold still. It showed up as a click that could never land,
       * because the button never stopped moving.
       *
       * Pushing the root's top down 60% moves the crossing point several hundred
       * pixels away from anything the header can shift, so the loop cannot close.
       */
      { threshold: 0, rootMargin: '-60% 0px 0px 0px' },
    );
    io.observe(hero);
    register(() => io.disconnect());
  }
</script>
