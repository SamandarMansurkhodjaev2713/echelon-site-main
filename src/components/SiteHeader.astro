---
import type { Dict, Locale } from '../lib/i18n';

interface Props {
  dict: Dict;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const langs: Array<{ code: Locale; label: string; href: string }> = [
  { code: 'ru', label: 'RU', href: `${base}/` },
  { code: 'uz', label: 'UZ', href: `${base}/uz/` },
  { code: 'en', label: 'EN', href: `${base}/en/` },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="site-header__brand" href={langs.find((l) => l.code === locale)?.href}>
      <img src={`${base}/media/favicon-192.png`} alt="" width="26" height="26" />
      <span>Echelon Desktop</span>
    </a>
    <nav class="site-header__langs" aria-label="Language">
      {
        langs.map((l) => (
          <a
            href={l.href}
            class={l.code === locale ? 'active' : ''}
            aria-current={l.code === locale ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="site-header__cta" href="#demo">{dict.nav.cta}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 60px;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 620;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .site-header__brand img {
    border-radius: 6px;
  }
  .site-header__langs {
    margin-left: auto;
    display: flex;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
  }
  .site-header__langs a {
    padding: 0.35em 0.7em;
    border-radius: var(--radius-sm);
    color: var(--fg-subtle);
    transition: color var(--motion-fast) var(--ease-out);
  }
  .site-header__langs a:hover {
    color: var(--fg);
  }
  .site-header__langs a.active {
    color: var(--gold);
    background: var(--gold-faint);
  }
  .site-header__cta {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--gold);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: var(--radius-md);
    padding: 0.5em 1em;
    transition:
      background var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
    white-space: nowrap;
  }
  .site-header__cta:hover {
    background: var(--gold);
    color: #0b0b0a;
  }
  @media (max-width: 560px) {
    .site-header__brand span {
      display: none;
    }
  }
</style>
