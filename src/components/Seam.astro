---
/*
 * A SEAM — where the record stops and you are looking straight at the machine.
 *
 * Two jobs. The first is structural: fifteen thousand pixels of sections that
 * all open the same way (mono kicker → headline → grey lead) gave the eye no
 * landmarks, which is most of what "unreadable" actually meant here. A seam is
 * a chapter break you cannot mistake for a section.
 *
 * The second is that it is the one place the attention field is the subject
 * rather than a watermark — `data-field-surface="1"` tells motion/field.ts to
 * bring the constellation all the way up, and the veil drops to zero so there
 * is no paper between the reader and it.
 *
 * It is never blank space. A seam carries the shift's own log line for the
 * moment it marks, so it reads as the system changing state rather than as a
 * gap where a section failed to load.
 */
interface Props {
  time: string;
  state: string;
  note: string;
  /** the clock anchor this seam contributes to motion/shift.ts */
  shift?: string;
}

const { time, state, note, shift } = Astro.props;
---

<div class="seam" data-field-surface="1" data-shift={shift ?? time}>
  <div class="page seam__page">
    <p class="seam__mark" data-reveal="receive">
      <span class="seam__time sys">{time}</span>
      <span class="seam__rule" aria-hidden="true"></span>
      <span class="seam__state">{state}</span>
    </p>
    <p class="seam__note" data-reveal="receive">{note}</p>
  </div>
</div>

<style>
  .seam {
    display: flex;
    align-items: center;
    /* Tall enough that the field is unmistakably the subject, short enough that
       it never feels like the page has stalled. */
    min-height: clamp(11rem, 30vh, 22rem);
  }

  .seam__page {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    text-align: center;
  }

  .seam__mark {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2vw, 1.3rem);
    font-family: var(--font-system);
    font-size: var(--step-label);
    font-weight: 560;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .seam__time {
    color: var(--signal);
  }

  .seam__state {
    color: var(--ink);
  }

  /* A hairline that draws itself as the seam arrives — the log line being
     written, not a decorative divider that was always there. */
  .seam__rule {
    display: block;
    width: clamp(2.5rem, 9vw, 7rem);
    height: 1px;
    background: var(--rule-strong);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-scene) var(--ease-editorial) 120ms;
  }
  :global(html.js) .seam__mark.is-in .seam__rule {
    transform: scaleX(1);
  }
  :global(html:not(.js)) .seam__rule {
    transform: none;
  }

  .seam__note {
    font-family: var(--font-human);
    font-style: italic;
    font-size: var(--step-small);
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .seam__rule {
      transform: none;
      transition: none;
    }
  }
</style>
