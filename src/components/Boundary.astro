---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const b = dict.boundary;
const done = b.tasks.slice(0, -1);
const gate = b.tasks[b.tasks.length - 1]!;
---

<!--
  ESCALATE (§20).
  Three operations complete in sequence and the fourth stops dead against a rule
  only the owner can cross. Not an error state: the boundary is drawn in the
  owner's colour, because the owner is exactly what it is waiting for.
-->
<section class="bound band" id="boundary" data-produces="6" data-action="saw-boundary">
  <div class="page">
    <p class="label">{b.label}</p>
    <h2 class="title bound__title">{b.title}</h2>

    <ol class="bound__tasks" data-stagger>
      {
        done.map((t) => (
          <li class="bound__task" data-reveal="receive">
            <span class="bound__task-name">{t.name}</span>
            <span class="bound__task-state sys">{t.state}</span>
          </li>
        ))
      }
      <li class="bound__task bound__task--gate" data-reveal="escalate" data-gate>
        <span class="bound__task-name">{gate.name}</span>
        <span class="bound__task-state bound__task-state--gate sys">{gate.state}</span>
      </li>
    </ol>

    <div class="bound__gate" data-gate-panel>
      <div class="bound__gate-head">
        <span class="label label--signal">{b.gateLabel}</span>
      </div>
      <p class="bound__gate-reason">{b.gateReason}</p>
      <div class="bound__gate-actions">
        <button type="button" class="bound__decide" data-decide="approve" data-cursor="approve">
          {b.approve}
        </button>
        <button type="button" class="bound__decide" data-decide="reject" data-cursor="approve">
          {b.reject}
        </button>
        <p class="bound__gate-result label" data-gate-result role="status"></p>
      </div>
      <p class="note bound__gate-note">{b.gateNote}</p>
    </div>

    <div class="bound__limits editorial">
      <div>
        <p class="label">{b.limitsLabel}</p>
        <ul class="bound__limit-list" data-stagger>
          {
            b.limits.map((l) => (
              <li class="bound__limit" data-reveal="archive">
                {l}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="editorial__margin bound__aside">
        <p class="human bound__honesty">{b.honesty}</p>
        <p class="note bound__setup">{b.setup}</p>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    data-gate-copy
    is:inline
    set:html={JSON.stringify({ approved: b.approved, rejected: b.rejected })}
  />
</section>

<style>
  .bound {
    background: var(--paper-deep);
    border-bottom: 1px solid var(--rule);
  }
  .bound__title {
    margin-top: 0.6rem;
    max-width: 20ch;
  }

  .bound__tasks {
    margin-top: clamp(2rem, 5vh, 3.5rem);
    max-width: 46rem;
  }
  .bound__task {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .bound__task-name {
    font-size: var(--step-lead);
    color: var(--ink);
  }
  .bound__task-state {
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--machine);
  }

  /* the line where the machine stops */
  .bound__task--gate {
    border-top: 1px solid var(--signal);
    border-bottom: 1px solid var(--signal);
    background: var(--signal-wash);
    padding-inline: clamp(0.75rem, 2vw, 1.1rem);
    margin-inline: clamp(-1.1rem, -2vw, -0.75rem);
  }
  /* on the signal-washed gate row the darker ink keeps AA contrast */
  .bound__task-state--gate {
    color: var(--signal-deep);
  }

  .bound__gate {
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
    max-width: 46rem;
  }
  .bound__gate-reason {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    max-width: 44ch;
  }
  .bound__gate-actions {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }
  .bound__decide {
    min-height: 2.75rem;
    padding: 0.55em 1.2em;
    font-weight: 560;
    color: var(--signal);
    border: 1px solid var(--signal);
    transition:
      background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .bound__decide:hover,
  .bound__decide:focus-visible {
    background: var(--signal);
    color: var(--paper);
  }
  .bound__decide[data-chosen] {
    background: var(--signal);
    color: var(--paper);
  }
  .bound__gate-result {
    color: var(--signal);
  }
  .bound__gate-note {
    margin-top: 0.9rem;
  }

  .bound__limits {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-top: clamp(1.5rem, 4vh, 2.25rem);
    border-top: 1px solid var(--rule-strong);
  }
  .bound__limit-list {
    margin-top: 0.85rem;
    max-width: 34rem;
  }
  .bound__limit {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-lead);
    color: var(--ink);
  }
  .bound__aside {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
  .bound__honesty {
    color: var(--ink-muted);
    max-width: 40ch;
  }
  @media (min-width: 60rem) {
    .bound__aside {
      grid-column: 2;
    }
    .bound__honesty,
    .bound__setup {
      max-width: none;
    }
  }
</style>

<script>
  import { session } from '../session/state';
  import { register } from '../motion/lifecycle';

  const panel = document.querySelector<HTMLElement>('[data-gate-panel]');
  const copyEl = document.querySelector('[data-gate-copy]');
  if (panel && copyEl?.textContent) {
    const copy = JSON.parse(copyEl.textContent) as { approved: string; rejected: string };
    const result = panel.querySelector<HTMLElement>('[data-gate-result]');
    const buttons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-decide]'));
    const store = session();

    for (const btn of buttons) {
      const handler = () => {
        for (const b of buttons) b.toggleAttribute('data-chosen', b === btn);
        if (result) {
          result.textContent = btn.dataset.decide === 'approve' ? copy.approved : copy.rejected;
        }
        // The decision the machine could not make is recorded as the owner's.
        store.remember('escalations', 'invoice-214');
      };
      btn.addEventListener('click', handler);
      register(() => btn.removeEventListener('click', handler));
    }
  }
</script>
