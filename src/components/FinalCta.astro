---
import type { Dict } from '../lib/i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const f = dict.finalCta;
---

<section class="final" id="demo">
  <div class="narrow final__inner">
    <h2>{f.title}</h2>
    <p class="lead final__text">{f.text}</p>
    <a class="btn-cta final__btn" href="https://t.me/komrxn" target="_blank" rel="noopener">
      {f.button}
    </a>
    <p class="cta-note">{f.note}</p>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: clip;
    padding-block: var(--section-gap);
    text-align: center;
  }
  .final::before {
    content: '';
    position: absolute;
    inset: auto -10% -40%;
    height: 90%;
    background: radial-gradient(
      ellipse 55% 50% at 50% 100%,
      rgba(200, 169, 81, 0.09),
      transparent 70%
    );
    pointer-events: none;
  }
  .final__inner {
    position: relative;
  }
  .final__text {
    margin-inline: auto;
    margin-top: 1.25rem;
  }
  .final__btn {
    margin-top: 2.25rem;
    font-size: var(--text-lead);
  }
</style>
