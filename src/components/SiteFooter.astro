---
import type { Dict } from '../lib/i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const f = dict.footer;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="container footer__row">
    <div class="footer__brand">
      <img src={`${base}/media/favicon-192.png`} alt="" width="22" height="22" loading="lazy" />
      <div>
        <div class="footer__name">{f.product}</div>
        <div class="footer__line">{f.line}</div>
      </div>
    </div>
    <div class="footer__meta mono">
      <a href="https://t.me/komrxn" target="_blank" rel="noopener">t.me/komrxn</a>
      <span>{f.demoNote}</span>
      <span>{f.rights}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding-block: 2.5rem 3rem;
  }
  .footer__row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .footer__brand {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
  }
  .footer__brand img {
    border-radius: 5px;
    margin-top: 0.2rem;
  }
  .footer__name {
    font-weight: 620;
  }
  .footer__line {
    color: var(--fg-subtle);
    font-size: var(--text-small);
    margin-top: 0.2rem;
  }
  .footer__meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: var(--text-micro);
    color: var(--fg-subtle);
    text-align: right;
  }
  .footer__meta a {
    color: var(--gold);
  }
  @media (max-width: 640px) {
    .footer__meta {
      text-align: left;
    }
  }
</style>
