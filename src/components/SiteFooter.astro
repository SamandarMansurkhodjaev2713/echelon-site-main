---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const f = dict.footer;
---

<footer class="foot">
  <div class="page foot__row">
    <div class="foot__brand">
      <Image src={mark} alt="" width={20} height={20} loading="lazy" densities={[1, 2]} />
      <div>
        <p class="foot__name">{f.product}</p>
        <p class="foot__line">{f.line}</p>
      </div>
    </div>
    <div class="foot__meta">
      <a href="https://t.me/komrxn" target="_blank" rel="noopener" data-cursor="open">t.me/komrxn</a>
      <p>{f.demoNote}</p>
      <p>{f.rights}</p>
      <button type="button" class="foot__reset" data-session-reset>{dict.nav.reset}</button>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule-strong);
    padding-block: 2.5rem 3rem;
  }
  .foot__row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .foot__brand {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .foot__brand img {
    margin-top: 0.2rem;
    border-radius: 4px;
  }
  .foot__name {
    font-weight: 620;
  }
  .foot__line {
    color: var(--machine);
    font-size: var(--step-small);
    margin-top: 0.15rem;
    max-width: 34ch;
  }
  .foot__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    font-family: var(--font-system);
    font-size: var(--step-micro);
    color: var(--machine);
  }
  .foot__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: var(--signal);
    border-bottom: 1px solid transparent;
  }
  .foot__meta a:hover {
    border-bottom-color: var(--signal);
  }
  .foot__reset {
    min-height: 2.25rem;
    color: var(--machine);
    border-bottom: 1px solid var(--rule-strong);
  }
  .foot__reset:hover {
    color: var(--ink);
  }
  @media (min-width: 48rem) {
    .foot__meta {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>

<script>
  import { session } from '../session/state';
  import { register } from '../motion/lifecycle';

  const btn = document.querySelector<HTMLElement>('[data-session-reset]');
  if (btn) {
    const handler = () => {
      session().reset();
      // A reset must be visible, and it must also clear the intro flag so the
      // next load genuinely starts over. Deterministic for tests (§35).
      try {
        sessionStorage.removeItem('echelon_intro_v1');
      } catch {
        /* storage unavailable — the reset above still applied */
      }
      location.href = location.pathname + '?session=reset';
    };
    btn.addEventListener('click', handler);
    register(() => btn.removeEventListener('click', handler));
  }
</script>
