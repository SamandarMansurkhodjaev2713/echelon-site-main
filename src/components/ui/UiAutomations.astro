---
import type { Dict } from '../../i18n';

interface Props {
  dict: Dict;
  highlightLast?: boolean;
}

const { dict, highlightLast = false } = Astro.props;
const a = dict.ui.automations;
---

<div class="ui-autolist">
  {
    a.rows.map((row, i) => (
      <div
        class="ui-autorow"
        data-autorow={i}
        style={highlightLast && i === a.rows.length - 1 ? 'border-color:var(--ui-accent)' : ''}
      >
        <div>
          <div class="ui-autorow__name">{row.name}</div>
          <div class="ui-autorow__sched sys">{row.schedule}</div>
        </div>
        <span class="ui-autorow__badge" data-active={a.active} data-paused={a.paused}>
          {a.active}
        </span>
        <button
          type="button"
          class={`ui-autorow__toggle${row.active ? '' : ' off'}`}
          aria-label={`${a.toggleLabel}: ${row.name}`}
          aria-pressed={row.active ? 'true' : 'false'}
          data-cursor="run"
        />
      </div>
    ))
  }
</div>

<style>
  .ui-autolist {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
