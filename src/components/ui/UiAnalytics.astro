---
import type { Dict } from '../../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const a = dict.ui.analytics;
const max = Math.max(...a.values);
---

<div class="ui-ana">
  <div class="ui-ana__kpis">
    {
      a.kpis.map((k) => (
        <div class="ui-ana__kpi">
          <div class="ui-ana__kpi-label">{k.label}</div>
          <div class="ui-ana__kpi-value sys">{k.value}</div>
        </div>
      ))
    }
  </div>
  <div class="ui-ana__chart" role="img" aria-label={`${a.chartLabel}: ${a.days.map((d, i) => `${d} $${a.values[i]}`).join(', ')}`}>
    {
      a.values.map((v, i) => (
        <div class="ui-ana__col" aria-hidden="true">
          <span class="ui-ana__val sys">${v.toFixed(2)}</span>
          <i style={`height:${Math.round((v / max) * 100)}%`} />
          <span class="ui-ana__day sys">{a.days[i]}</span>
        </div>
      ))
    }
  </div>
  <p class="ui-ana__note">{a.note}</p>
</div>
