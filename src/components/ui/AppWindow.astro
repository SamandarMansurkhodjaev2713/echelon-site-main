---
import { Image } from 'astro:assets';
import mark from '../../assets/mark.png';
import type { Dict } from '../../i18n';
import { icon } from './icons';

interface Props {
  dict: Dict;
  active: 'chat' | 'graph' | 'kanban' | 'automations';
  bell?: number;
  class?: string;
  interactive?: boolean;
}

const { dict, active, bell = 3, class: className = '', interactive = false } = Astro.props;
const nav = dict.ui.nav;

const PANES = ['chat', 'graph', 'vault', 'kanban', 'automations', 'analytics'];

const groups = [
  {
    label: nav.daily,
    items: [
      { id: 'chat', icon: 'chat', label: nav.chat },
      { id: 'home', icon: 'home', label: nav.home },
    ],
  },
  {
    label: nav.memory,
    items: [
      { id: 'graph', icon: 'graph', label: nav.graph },
      { id: 'vault', icon: 'vault', label: nav.vault },
      { id: 'sessions', icon: 'sessions', label: nav.sessions },
    ],
  },
  {
    label: nav.operate,
    items: [
      { id: 'kanban', icon: 'kanban', label: nav.kanban },
      { id: 'automations', icon: 'zap', label: nav.automations },
      { id: 'skills', icon: 'sparkles', label: nav.skills },
      { id: 'computer', icon: 'monitor', label: nav.computer },
    ],
  },
  { label: nav.channels, items: [{ id: 'connections', icon: 'plug', label: nav.connections }] },
  {
    label: nav.brain,
    items: [
      { id: 'models', icon: 'cpu', label: nav.models },
      { id: 'analytics', icon: 'chart', label: nav.analytics },
    ],
  },
];

const paneTitle = (id: string): string =>
  id === 'chat'
    ? nav.chat
    : id === 'graph'
      ? nav.graph
      : id === 'vault'
        ? nav.vault
        : id === 'kanban'
          ? nav.kanban
          : id === 'automations'
            ? nav.automations
            : nav.analytics;
---

<div class={`ui app-window ${className}`.trim()}>
  <div class="app-window__titlebar">
    <span class="app-window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="app-window__title">{dict.ui.appTitle}</span>
  </div>
  <div class="app-window__body">
    <nav class="ui-side" aria-label={dict.ui.appTitle}>
      <div class="ui-side__brand">
        <Image src={mark} alt="" loading="lazy" width={18} height={18} densities={[1, 2]} />
        <span>{dict.ui.appTitle}</span>
      </div>
      {
        groups.map((g) => (
          <>
            <div class="ui-side__group">{g.label}</div>
            {g.items.map((it) =>
              interactive && PANES.includes(it.id) ? (
                <button
                  type="button"
                  class={`ui-side__item ui-side__item--link${it.id === active ? ' active' : ''}`}
                  data-app-nav={it.id}
                  data-title={paneTitle(it.id)}
                  aria-current={it.id === active ? 'page' : 'false'}
                  data-cursor="open"
                >
                  <Fragment set:html={icon(it.icon)} />
                  <span>{it.label}</span>
                </button>
              ) : (
                <div class={`ui-side__item${it.id === active ? ' active' : ''}`}>
                  <Fragment set:html={icon(it.icon)} />
                  <span>{it.label}</span>
                </div>
              ),
            )}
          </>
        ))
      }
    </nav>
    <div class="ui-main">
      <div class="ui-topbar">
        <span data-app-title>{paneTitle(active)}</span>
        <span class="ui-topbar__spacer"></span>
        <span class="ui-topbar__bell" aria-hidden="true">
          <Fragment set:html={icon('bell')} />
          {bell > 0 && <span class="ui-topbar__badge">{bell}</span>}
        </span>
      </div>
      <div class="ui-content">
        <slot />
      </div>
    </div>
  </div>
  <p class="sr-only" role="status" data-kanban-live></p>
</div>
