---
import type { Dict } from '../../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const g = dict.ui.graph;
const legend = [
  { color: '#f5f4ef', label: g.legend.owner },
  { color: '#e5a33a', label: g.legend.people },
  { color: '#4ecb58', label: g.legend.projects },
  { color: '#e55353', label: g.legend.memories },
  { color: '#8a8a85', label: g.legend.themes },
];
---

<div class="ui-graph" data-graph>
  <!-- The canvas is decorative to assistive tech; the same information is
       available as text here and, in full, in the Vault pane. -->
  <canvas aria-hidden="true"></canvas>
  <p class="sr-only">{dict.product.graphAlt}</p>
  <span class="ui-graph__stats sys" data-graph-stats></span>
  <span class="ui-graph__hint sys">{g.hint}</span>
  <div class="ui-graph__legend">
    {
      legend.map((l) => (
        <span>
          <i style={`background:${l.color}`} aria-hidden="true" />
          {l.label}
        </span>
      ))
    }
  </div>
</div>

<script
  type="application/json"
  id="graph-data"
  is:inline
  set:html={JSON.stringify({ stats: g.stats, hint: g.hint, card: g.card, data: g.data })}
/>
