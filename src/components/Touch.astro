---
import type { Dict } from '../lib/i18n';
import AppWindow from './ui/AppWindow.astro';
import UiChat from './ui/UiChat.astro';
import UiGraph from './ui/UiGraph.astro';
import UiVault from './ui/UiVault.astro';
import UiKanban from './ui/UiKanban.astro';
import UiAutomations from './ui/UiAutomations.astro';
import UiAnalytics from './ui/UiAnalytics.astro';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const t = dict.touch;
const tabs = [
  { id: 'chat', label: t.tabs.chat },
  { id: 'graph', label: t.tabs.graph },
  { id: 'vault', label: t.tabs.vault },
  { id: 'kanban', label: t.tabs.kanban },
  { id: 'automations', label: t.tabs.automations },
  { id: 'analytics', label: t.tabs.analytics },
] as const;
---

<section class="touch" id="touch">
  <div class="container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p class="lead touch__intro">{t.intro}</p>

    <div class="touch__bar">
      <div class="touch__tabs" role="tablist" data-touch-tabs>
        {
          tabs.map((tab, i) => (
            <button
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-touch-tab={tab.id}
              class={i === 0 ? 'active' : ''}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
      <span class="touch__hint mono">{t.hint}</span>
      <span class="touch__demo-note mono">{t.demoNote}</span>
    </div>

    <div class="touch__stage reveal" data-touch-stage>
      <AppWindow dict={dict} active="chat" interactive>
        <div data-touch-pane="chat" class="touch__pane active">
          <UiChat dict={dict} interactive />
        </div>
        <div data-touch-pane="graph" class="touch__pane" hidden>
          <UiGraph dict={dict} />
        </div>
        <div data-touch-pane="vault" class="touch__pane" hidden>
          <UiVault dict={dict} />
        </div>
        <div data-touch-pane="kanban" class="touch__pane" hidden>
          <UiKanban dict={dict} />
        </div>
        <div data-touch-pane="automations" class="touch__pane" hidden>
          <UiAutomations dict={dict} />
        </div>
        <div data-touch-pane="analytics" class="touch__pane" hidden>
          <UiAnalytics dict={dict} />
        </div>
      </AppWindow>
    </div>
  </div>
</section>

<script>
  import('../lib/touch').then((m) => m.initTouch());
</script>

<style>
  .touch__intro {
    margin-top: 1rem;
  }
  .touch__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.25rem;
    flex-wrap: wrap;
  }
  .touch__tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .touch__tabs [role='tab'] {
    font-size: var(--text-small);
    font-weight: 560;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.5em 1.1em;
    transition:
      color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      background var(--motion-fast) var(--ease-out);
  }
  .touch__tabs [role='tab']:hover {
    color: var(--fg);
  }
  .touch__tabs [role='tab'].active {
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 55%, transparent);
    background: var(--gold-faint);
  }
  .touch__hint {
    font-size: var(--text-micro);
    color: var(--fg-subtle);
  }
  .touch__demo-note {
    margin-left: auto;
    font-size: var(--text-micro);
    color: var(--fg-subtle);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.25em 0.7em;
  }
  .touch__stage {
    margin-top: 1.25rem;
    max-width: 1040px;
  }
  .touch__pane[hidden] {
    display: none;
  }
  .touch__pane {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  .touch__stage :global(.app-window__body) {
    height: 540px;
  }
  .touch__stage :global(.ui-content) {
    overflow-y: auto;
  }
  @media (min-width: 1000px) {
    .touch__tabs {
      display: none; /* on desktop you walk the app by its own sidebar */
    }
  }
  @media (max-width: 720px) {
    .touch__stage {
      margin-inline: calc(var(--gutter) * -0.4);
    }
    .touch__stage :global(.app-window__body) {
      height: 460px;
    }
    .touch__hint {
      display: none;
    }
  }
</style>
