---
import type { Dict } from '../lib/i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const w = dict.words;
---

<section class="words" id="words">
  <div class="container">
    <p class="eyebrow">{w.eyebrow}</p>
    <h2>{w.title}</h2>
    <p class="lead words__lead">{w.lead}</p>

    <div class="words__demo reveal" data-words>
      <div class="words__composer ui">
        <span class="words__typed mono" data-words-typed data-full={w.instruction}
        >{w.instruction}</span>
      </div>
      <div class="words__arrow mono" aria-hidden="true">↓</div>
      <div class="ui words__result" data-words-result>
        <div class="ui-autorow" style="border-color:var(--ui-accent)">
          <div>
            <div class="ui-autorow__name">{dict.ui.automations.rows[2]!.name}</div>
            <div class="ui-autorow__sched">{dict.ui.automations.rows[2]!.schedule}</div>
          </div>
          <span class="ui-autorow__badge">{dict.ui.automations.active}</span>
          <span class="ui-autorow__toggle"></span>
        </div>
      </div>
      <p class="words__resultline">{w.result}</p>
      <p class="words__correction">{w.correction}</p>
    </div>

    <p class="words__explain">{w.explain}</p>

    <div class="words__switcher reveal">
      <p class="words__switcher-label mono">{w.switcherLabel}</p>
      <div class="words__biz" role="tablist" data-biz-tabs>
        {
          w.businesses.map((b, i) => (
            <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={i === 0 ? 'active' : ''} data-biz={b.id}>
              {b.name}
            </button>
          ))
        }
      </div>
      <ul class="words__cases" data-biz-cases>
        {
          w.businesses[0]!.cases.map((c) => (
            <li>
              <span class="words__quote">«{c}»</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script
  type="application/json"
  id="biz-data"
  is:inline
  set:html={JSON.stringify(w.businesses.map((b) => ({ id: b.id, cases: b.cases })))}
/>

<script>
  import('../lib/words').then((m) => m.initWords());
</script>

<style>
  .words {
    background: var(--bg-raised);
    border-block: 1px solid var(--border-subtle);
  }
  .words__lead {
    margin-top: 1rem;
  }
  .words__demo {
    margin-top: 2.5rem;
    max-width: 640px;
  }
  .words__composer {
    background: var(--ui-bg);
    border: 1px solid var(--ui-border-strong);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    min-height: 4.6em;
    box-shadow: var(--shadow-window);
  }
  .words__typed {
    font-size: 0.95rem;
    color: var(--ui-fg);
    line-height: 1.55;
  }
  .words__typed::after {
    content: '▍';
    color: var(--ui-accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .words__arrow {
    text-align: center;
    color: var(--gold);
    font-size: 1.3rem;
    padding-block: 0.6rem;
  }
  .words__resultline {
    margin-top: 1rem;
    font-weight: 620;
    font-size: var(--text-lead);
  }
  .words__correction {
    margin-top: 0.5rem;
    color: var(--fg-muted);
  }
  .words__explain {
    margin-top: 2.5rem;
    max-width: 38em;
    color: var(--fg-muted);
    font-size: var(--text-lead);
    line-height: 1.55;
  }
  .words__switcher {
    margin-top: 3rem;
  }
  .words__switcher-label {
    font-size: var(--text-label);
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
  .words__biz {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .words__biz [role='tab'] {
    font-size: var(--text-small);
    font-weight: 560;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.5em 1.1em;
    transition:
      color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      background var(--motion-fast) var(--ease-out);
  }
  .words__biz [role='tab'].active {
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 55%, transparent);
    background: var(--gold-faint);
  }
  .words__cases {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    max-width: 640px;
  }
  .words__cases li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--border-subtle);
    transition: opacity var(--motion-base) var(--ease-out);
  }
  .words__cases li:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }
  .words__quote {
    color: var(--fg);
    font-size: var(--text-body);
  }
</style>
