---
import type { Dict } from '../lib/i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const b = dict.before;
---

<section class="before">
  <div class="container before__grid">
    <div class="before__text">
      <p class="eyebrow">{b.eyebrow}</p>
      <h2>{b.title}</h2>
      <ul class="before__beats">
        {b.beats.map((beat) => <li class="reveal">{beat}</li>)}
      </ul>
    </div>
    <div class="before__chaos" aria-hidden="true">
      {
        b.chaosMessages.map((m, i) => (
          <div class="before__msg reveal" style={`--i:${i}`}>
            <span class="before__from">{m.from}</span>
            <span class="before__body">{m.text}</span>
          </div>
        ))
      }
      <div class="before__badge mono">24</div>
    </div>
  </div>
</section>

<style>
  .before {
    background: var(--bg-raised);
    border-block: 1px solid var(--border-subtle);
  }
  .before__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .before__beats {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }
  .before__beats li {
    padding-block: 1.1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 24em;
  }
  .before__beats li:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }
  .before__chaos {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 0;
  }
  .before__msg {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    max-width: 88%;
    transition-delay: calc(var(--i) * 90ms);
  }
  .before__msg:nth-child(even) {
    align-self: flex-end;
    transform-origin: right;
  }
  .before__from {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--gold);
  }
  .before__body {
    font-size: var(--text-small);
    color: var(--fg-muted);
  }
  .before__badge {
    position: absolute;
    top: -0.5rem;
    right: -0.25rem;
    background: var(--danger);
    color: #fff;
    font-size: var(--text-micro);
    font-weight: 700;
    border-radius: var(--radius-pill);
    padding: 0.15em 0.6em;
  }
  @media (max-width: 860px) {
    .before__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
