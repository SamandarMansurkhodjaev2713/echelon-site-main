---
import '@fontsource-variable/golos-text';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/spectral/500-italic.css';
import '@fontsource/spectral/500.css';
import '../styles/tokens.css';
import '../styles/base.css';

export interface Props {
  locale: 'ru' | 'en' | 'uz';
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://komrxn.github.io';

const localePath = (l: string) => (l === 'ru' ? `${base}/` : `${base}/${l}/`);
const canonical = `${site}${localePath(locale)}`;
const ogImage = `${site}${base}/og/og-${locale}.png`;
const ogLocale = locale === 'ru' ? 'ru_RU' : locale === 'uz' ? 'uz_UZ' : 'en_US';
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0a" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={`${site}${localePath('ru')}`} />
    <link rel="alternate" hreflang="en" href={`${site}${localePath('en')}`} />
    <link rel="alternate" hreflang="uz" href={`${site}${localePath('uz')}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${localePath('ru')}`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/media/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/media/favicon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}/media/favicon-192.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Echelon Desktop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Scroll reveals: IO adds .in once. Everything readable without JS.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
